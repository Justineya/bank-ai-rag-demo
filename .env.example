# Agnes（OpenAI 兼容）。配上后生成步会真正调用大模型。
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# 任选其一即可启用「真实 LLM 生成」。不填也能跑通检索 + 抽取式回答。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# huggingface（默认中文句向量 bge-small-zh）| hashed（教学开关）
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# bm25 | vector | hybrid
RAG_RETRIEVER=bm25
# bge | lexical | none
RAG_RERANKER=bge
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_FETCH_K=16
RAG_TOP_K=4

# bank | minxin
RAG_TENANT=bank
# public（对客）| internal（对内，含已废止稿）| all（评测）
RAG_AUDIENCE=public
